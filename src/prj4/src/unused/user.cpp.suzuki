// user.cpp
// 一連の動きのシークエンスを定義する関数 UserMotion()
// これは SuzukiMotion() を利用するための書き方の例
// 2023年8月の時点ではやや内容が古いので注意、user.cpp.lessonを見よ

#include <math.h>
