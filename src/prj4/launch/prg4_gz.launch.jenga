<launch>
<!-- comment -->
<!-- 
    <include file="$(find prj4)/launch/empty_sky.launch">
        <arg name="paused" value="true"/>
    </include>
-->
<!-- 
    <include file="$(find prj4)/launch/empty_world.launch">
        <arg name="paused" value="true"/>
    </include>
-->

    <include file="$(find prj4)/launch/myworld_simple.launch">
        <arg name="paused" value="true"/>
    </include>
<!--
    <include file="$(find prj4)/launch/myworld_full.launch">
        <arg name="paused" value="true"/>
    </include>
-->
    <arg name="model" default="$(find prj4)/urdf/prg4.urdf" />
    <param name="robot_description" textfile="$(arg model)" />
    <node name="spawn_urdf_gz" pkg="gazebo_ros" type="spawn_model"
          args="-param robot_description -urdf -model prj4 -x 0 -y 0 -z 1.0 -R 0 -P 0 -Y 0" />
<!-- position in front of slope
	  args="-param robot_description -urdf -model prj4 -x -1.5 -y -7 -z 1.0 -R 0 -P 0 -Y 3.1415926" />
-->
    <node name="robot_state_publisher_gz" pkg="robot_state_publisher" type="robot_state_publisher" />
<!--
    <node name="tf_converter_gz" pkg="prj4" type="tf_converter" />
-->
    <rosparam file="$(find prj4)/config/prg4.yaml" command="load" />

    <node name="ctrl_spawner_gz" pkg="controller_manager" type="spawner" respawn="false" output="screen"
    	  ns="/prj4" args="j_state_con 
	  a1j1_pos_con  a1j2_pos_con  a1j3_pos_con  a1j4_pos_con  a1j5_pos_con  a1j6_pos_con  
	  a1j7_pos_con  a1j8_pos_con  a2j1_pos_con  a2j2_pos_con  a2j3_pos_con  a2j4_pos_con  
	  a2j5_pos_con  a2j6_pos_con  a2j7_pos_con  a2j8_pos_con  a3j1_pos_con  a3j2_pos_con  
	  a3j3_pos_con  a3j4_pos_con  a3j5_pos_con  a3j6_pos_con  a3j7_pos_con  a3j8_pos_con 
	  a4j1_pos_con  a4j2_pos_con  a4j3_pos_con  a4j4_pos_con  a4j5_pos_con  a4j6_pos_con  
	  a4j7_pos_con  a4j8_pos_con  a5j1_pos_con  a5j2_pos_con  a5j3_pos_con  a5j4_pos_con  
	  a5j5_pos_con  a5j6_pos_con  a5j7_pos_con  a5j8_pos_con  a6j1_pos_con  a6j2_pos_con  
	  a6j3_pos_con  a6j4_pos_con  a6j5_pos_con  a6j6_pos_con  a6j7_pos_con  a6j8_pos_con 
	  a7j1_pos_con  a7j2_pos_con " />

    <arg name="pole100" default="$(find prj4)/urdf/Pole100.urdf"/>
    <param name="pole100_description" textfile="$(arg pole100)"/>
    <node name="pole100_spawner_gz" pkg="gazebo_ros" type="spawn_model"
    	  args="-param pole100_description -urdf -x 1 -y 0 -z 0.0 -model pole100" />
<!--
    <node name="pole100_spawner_gz2" pkg="gazebo_ros" type="spawn_model"
    	  args="-param pole100_description -urdf -x 1.5 -y 1 -z 0.0 -model pole1002" />

    <node name="pole100_spawner_gz3" pkg="gazebo_ros" type="spawn_model"
    	  args="-param pole100_description -urdf -x 1.5 -y -0.5 -z 0.0 -model pole1003" />

    <arg name="pole60" default="$(find prj4)/urdf/Pole60.urdf"/>
    <param name="pole60_description" textfile="$(arg pole60)"/>
    <node name="pole60_spawner_gz" pkg="gazebo_ros" type="spawn_model"
    	  args="-param pole60_description -urdf -x 1 -y 1 -z 0.0 -model pole60" />

    <arg name="pole80" default="$(find prj4)/urdf/Pole80.urdf"/>
    <param name="pole80_description" textfile="$(arg pole80)"/>
    <node name="pole80_spawner_gz" pkg="gazebo_ros" type="spawn_model"
    	  args="-param pole80_description -urdf -x 1 -y -0.5 -z 0.0 -model pole80" />
-->

    <node name="boxx1" pkg="gazebo_ros" type="spawn_model"
    	  args="-file $(find prj4)/sdf//models/Box/box3.sdf -sdf 
          -x 0.60 -y 0.05 -z 0.1 -model box_17" />

    <node name="box1" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box.sdf -sdf 
	  -x 0.525 -y 0.05 -z 0.1 -model box" />
    <node name="box2" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box_g.sdf -sdf 
          -x 0.60 -y 0.05 -z 0.1 -model box_0" />
    <node name="box3" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box_b.sdf -sdf 
          -x 0.675 -y 0.05 -z 0.1 -model box_1" />

    <node name="box4" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box2_g.sdf -sdf 
          -x 0.60 -y 0.05 -z 0.145  -model box_2" />
    <node name="box5" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box2_b.sdf -sdf 
          -x 0.60 -y 0.125 -z 0.145  -model box_3" />
    <node name="box6" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box2.sdf -sdf 
          -x 0.60 -y -0.025 -z 0.145  -model box_4" />

    <node name="box7" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box.sdf -sdf 
          -x 0.525 -y 0.05 -z 0.19 -model box_5" />
    <node name="box8" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box_g.sdf -sdf 
          -x 0.60 -y 0.05 -z 0.19 -model box_6" />
    <node name="box9" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box_b.sdf -sdf 
          -x 0.675 -y 0.05 -z 0.19 -model box_7" />

    <node name="box10" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box2_g.sdf -sdf 
          -x 0.60 -y 0.05 -z 0.235  -model box_8" />
    <node name="box11" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box2_b.sdf -sdf 
          -x 0.60 -y 0.125 -z 0.235  -model box_9" />
    <node name="box12" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box2.sdf -sdf 
          -x 0.60 -y -0.025 -z 0.235  -model box_10" />

    <node name="box13" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box.sdf -sdf 
          -x 0.525 -y 0.05 -z 0.28 -model box_11" />
    <node name="box14" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box_g.sdf -sdf 
          -x 0.60 -y 0.05 -z 0.28 -model box_12" />
    <node name="box15" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box_b.sdf -sdf 
          -x 0.675 -y 0.05 -z 0.28 -model box_13" />

    <node name="box16" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box2_g.sdf -sdf 
          -x 0.60 -y 0.05 -z 0.325  -model box_14" />
    <node name="box17" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box2_b.sdf -sdf 
          -x 0.60 -y 0.125 -z 0.325  -model box_15" />
    <node name="box18" pkg="gazebo_ros" type="spawn_model" 
          args="-file $(find prj4)/sdf//models/Box/box2.sdf -sdf 
          -x 0.60 -y -0.025 -z 0.325  -model box_16" />

</launch>
