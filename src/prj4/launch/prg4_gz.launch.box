<launch>
<!-- comment -->
<!-- 
    <include file="$(find prj4)/launch/empty_sky.launch">
    <include file="$(find prj4)/launch/empty_world.launch">
    <include file="$(find prj4)/launch/myworld_full.launch">
-->
    <include file="$(find prj4)/launch/myworld_simple.launch">
        <arg name="paused" value="true"/>
    </include>

    <arg name="boxs" default="$(find prj4)/urdf/boxs.urdf"/>
    <param name="boxs_description" textfile="$(arg boxs)"/>
    <node name="boxs_spawner_gz" pkg="gazebo_ros" type="spawn_model"
          args="-param boxs_description -urdf -x -0.05 -y 0.05 -z 0.6 -R 0 -P 0 -Y 0 -model boxs1" />

</launch>
