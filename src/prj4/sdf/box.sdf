<?xml version="1.0" ?>
<sdf version="1.5">

<model name="box">
<static>false</static>
<link name="box">

<visual name="box_visual">
<pose>0 0 0 0 0 0</pose>
<geometry> <box> <size>0.2 0.2 0.2</size> </box> </geometry>
<material> <script> <name>Gazebo/Green</name>
<uri>file://media/materials/scripts/gazebo.material</uri> </script>
</material>
</visual>

<collision name="box_collision">
<pose>0 0 0 0 0 0</pose>
<geometry> <box> <size>0.2 0.2 0.2</size> </box> </geometry>
<surface> <contact> <ode/> </contact>
<friction> <ode/> <torsional> <ode/> </torsional> </friction>
<bounce/> </surface>
<max_contacts>10</max_contacts>
</collision>
	
<inertial>
<pose>0 0 0 0 0 0</pose>
<mass>10</mass>
<inertia> <ixx>0.066</ixx> <ixy>0</ixy> <ixz>0</ixz>
<iyy>0.066</iyy> <iyz>0</iyz> <izz>0.066</izz> </inertia>
</inertial>
	
</link>
</model>
</sdf>
