<?xml version="1.0" ?>

<robot name="chechsr">

    <link name="base_link"></link>

    <joint name="base_joint" type="fixed">
        <parent link="base_link"/>                                                                      
        <child link="platex"/>
        <origin xyz= "0 0 0" rpy="0 0 0" />
    </joint>
      
    <link name="platex">
        <visual>
  	    <origin xyz="0 0 0" rpy="0 0 0" />
	    <geometry> <box size="0.1 0.05 0.05"/> </geometry>
	</visual>
	<collision>
	    <origin xyz="0 0 0" rpy="0 0 0" />
	    <geometry> <box size="0.1 0.05 0.05"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 0 0" rpy="0 0 0" />
	    <mass value="0.1" />
	    <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
	</inertial>
    </link>
    <gazebo reference="platex"> <material>Gazebo/Red</material> </gazebo>

    <joint name="joint1" type="fixed">
        <parent link="platex"/>
	<child  link="platey"/>
	<origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="platey">
        <visual>
	    <origin xyz="0 0 0" rpy="0 0 0" />
	    <geometry> <box size="0.05 0.1 0.05"/> </geometry>
	</visual>
	<collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
	    <geometry> <box size="0.05 0.1 0.05"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 0 0" rpy="0 0 0" />
	    <mass value="0.1" />
	    <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
	</inertial>
    </link>
    <gazebo reference="platey"> <material>Gazebo/Red</material> </gazebo>

    <joint name="joint2" type="fixed">
        <parent link="platex"/>
	<child  link="platez"/>
	<origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="platez">
        <visual>
	    <origin xyz="0 0 0" rpy="0 0 0" />
	    <geometry> <box size="0.05 0.05 0.1"/> </geometry>
	    <material name=""> <color rgba="1.0 1.0 1.0 1.0" /> </material>
	</visual>
	<collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
	    <geometry> <box size="0.05 0.05 0.1"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 0 0" rpy="0 0 0" />
	    <mass value="0.1" />
	    <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
	</inertial>
    </link>
    <gazebo reference="platez"> <material>Gazebo/Red</material> </gazebo>

</robot>
