<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="woodbox">
    <static>true</static>
    <link name="link">

      <collision name="woodboxcollision">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry> <box> <size>2 2 1</size> </box> </geometry>
        <surface>
          <friction> <ode> <mu>0.6</mu> <mu2>0.6</mu2> </ode> </friction>
        </surface>
      </collision>
      <visual name="woodboxvisual">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry> <box> <size>2 2 1</size> </box> </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Soil1</name>
          </script>
        </material>
      </visual>

    </link>
  </model>
</sdf>
