<!-- ################################################################### -->
<!-- ZMP link RF48 -->
<joint name="jointNNFT42" type="revolute">
        <parent link="linkNN48"/>
        <child link="linkNNFT42"/>
        <origin xyz= "0 0 0" rpy="0 0 0" />
        <axis xyz="1 0 0"/>
        <limit effort="100" lower="-0.1" upper="0.1" velocity="0.1"/>
    </joint>

    <link name="linkNNFT42">
        <visual>
            <origin xyz="0 -0.005 -0.025" rpy="0 0 0"/>
            <geometry> <box size="0.035 0.001 0.05"/> </geometry>
        </visual>
        <collision>
            <origin xyz="0 -0.005 0.025" rpy="0 0 0"/>
            <geometry> <box size="0.035 0.001 0.05"/> </geometry>
        </collision>
        <inertial>
            <origin xyz="0 -0.005 -0.025" rpy="0 0 0"/> <mass value="0.05"/>
            <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
        </inertial>
    </link>

    <gazebo reference="linkNNFT42"> <material>Gazebo/Blue</material> </gazebo>
	<gazebo> <mu1>1.5</mu1><mu2>1.5</mu2></gazebo>

	<transmission name="transNNFT42">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="jointNNFT42">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="motorNNFT42">
    <hardwareInterface>EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

<!-- ################################################################### -->
<!-- ZMPLink RF481 -->
<joint name="jointNNFT42a1" type="fixed">
        <parent link="linkNNFT42"/>
        <child link="linkNNFT42a1"/>
        <origin xyz= "0 0 -0.05" rpy="0 0 0" />
        <axis xyz="1 0 0"/>
        <limit effort="30" lower="-2.617" upper="2.617" velocity="1.571"/>
    </joint>

    <link name="linkNNFT42a1">
        <visual>
            <origin xyz="0 -0.05 0.005" rpy="0 0 0"/>
            <geometry> <box size="0.025 0.1 0.01"/> </geometry>
        </visual>
        <collision>
            <origin xyz="0 -0.05 0.005" rpy="0 0 0"/>
            <geometry> <box size="0.025 0.1 0.01"/> </geometry>
        </collision>
        <inertial>
            <origin xyz="0 -0.05 0.005" rpy="0 0 0"/> <mass value="0.05"/>
            <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
        </inertial>
    </link>

    <gazebo reference="linkNNFT42a1"> <material>Gazebo/Blue</material> </gazebo>
<!-- ################################################################### -->
<!-- ZMPLink RF482 -->
<joint name="jointNNFT42a2" type="fixed">
        <parent link="linkNNFT42a1"/>
        <child link="linkNNFT42a2"/>
        <origin xyz= "0 0 0.025" rpy="0 0 0" />
        <axis xyz="1 0 0"/>
    	<limit effort="30" lower="-2.617" upper="2.617" velocity="1.571"/>
	</joint>

    <link name="linkNNFT42a2">
        <visual>
            <origin xyz="0 -0.095 0" rpy="0 0 0"/>
            <geometry> <box size="0.025 0.001 0.05"/> </geometry>
        </visual>
        <collision>
            <origin xyz="0 -0.095 0" rpy="0 0 0"/>
            <geometry> <box size="0.025 0.001 0.05"/> </geometry>
        </collision>
        <inertial>
            <origin xyz="0 -0.095 0" rpy="0 0 0"/> <mass value="0.05"/>
            <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
        </inertial>
    </link>

    <gazebo reference="linkNNFT42a2"> <material>Gazebo/Blue</material> </gazebo>

<!-- ################################################################### -->
<!--ZMP sensor-->

<gazebo reference="jointNNFT42">
  <provideFeedback>true</provideFeedback>
  <!-- turnGravityOff>false</turnGravityOff -->
</gazebo>

<gazebo>
  <plugin name="ft_rf2_sensor" filename="libgazebo_ros_ft_sensor.so">
    <updateRate>100.0</updateRate>
        <topicName>ftsensor_rf2/raw</topicName>
        <jointName>jointNNFT42</jointName>
        <gaussianNoise>0.0</gaussianNoise>
  </plugin>
</gazebo>

<!-- ################################################################### -->
