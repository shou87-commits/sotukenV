<!-- ################################################################### -->
<!--ZMP sensor-->

<gazebo reference="jointNNFT11">
  <provideFeedback>true</provideFeedback>
  <!-- turnGravityOff>false</turnGravityOff -->
</gazebo>

<gazebo>
  <plugin name="ft_lf1_sensor" filename="libgazebo_ros_ft_sensor.so">
    <updateRate>100.0</updateRate>
        <topicName>ftsensor_lf1/raw</topicName>
        <jointName>jointNNFT11</jointName>
        <gaussianNoise>0.0</gaussianNoise>
  </plugin>
</gazebo>

