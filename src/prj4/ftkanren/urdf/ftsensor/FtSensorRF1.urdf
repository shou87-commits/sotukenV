<!-- ################################################################### -->
<!--ZMP sensor-->

<gazebo reference="jointNNFT41">
  <provideFeedback>true</provideFeedback>
  <!-- turnGravityOff>false</turnGravityOff -->
</gazebo>

<gazebo>
  <plugin name="ft_rf1_sensor" filename="libgazebo_ros_ft_sensor.so">
    <updateRate>100.0</updateRate>
        <topicName>ftsensor_rf1/raw</topicName>
        <jointName>jointNNFT41</jointName>
        <gaussianNoise>0.0</gaussianNoise>
  </plugin>
</gazebo>

