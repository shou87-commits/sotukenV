<!-- ################################################################### -->
<!-- ZMP link RF47 -->
<joint name="jointNNFT41" type="revolute">
        <parent link="linkNN47"/>
        <child link="linkNNFT41"/>
        <origin xyz= "0 0 0" rpy="0 0 0" />
        <axis xyz="1 0 0"/>
        <limit effort="100" lower="-0.1" upper="0.1" velocity="0.1"/>
    </joint>

    <link name="linkNNFT41">
        <visual>
            <origin xyz="0 -0.005 0.025" rpy="0 0 0"/>
            <geometry> <box size="0.035 0.001 0.05"/> </geometry>
        </visual>
        <collision>
            <origin xyz="0 -0.005 0.025" rpy="0 0 0"/>
            <geometry> <box size="0.035 0.001 0.05"/> </geometry>
        </collision>
        <inertial>
            <origin xyz="0 -0.005 0.025" rpy="0 0 0"/> <mass value="0.05"/>
            <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
        </inertial>
    </link>

    <gazebo reference="linkNNFT41"> <material>Gazebo/Blue</material> </gazebo>
	<gazebo> <mu1>1.5</mu1><mu2>1.5</mu2></gazebo>

	<transmission name="transNNFT41">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="jointNNFT41">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="motorNNFT41">
    <hardwareInterface>EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

<!-- ################################################################### -->
<!-- ZMPLink RF471 -->
<joint name="jointNNFT141a1" type="fixed">
        <parent link="linkNNFT41"/>
        <child link="linkNNFT41a1"/>
        <origin xyz= "0.03 0 0.05" rpy="0 0 0" />
        <axis xyz="1 0 0"/>
    	<limit effort="30" lower="-2.617" upper="2.617" velocity="1.571"/>
	</joint>

    <link name="linkNNFT41a1">
        <visual>
            <origin xyz="0 -0.05 -0.005" rpy="0 0 0"/>
            <geometry> <box size="0.025 0.1 0.01"/> </geometry>
        </visual>
        <collision>
            <origin xyz="0 -0.05 -0.005" rpy="0 0 0"/>
            <geometry> <box size="0.025 0.1 0.01"/> </geometry>
        </collision>
        <inertial>
            <origin xyz="0 -0.05 -0.005" rpy="0 0 0"/> <mass value="0.05"/>
            <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
        </inertial>
    </link>

    <gazebo reference="linkNNFT41a1"> <material>Gazebo/Blue</material> </gazebo>
