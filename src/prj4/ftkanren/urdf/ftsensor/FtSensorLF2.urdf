<!-- ################################################################### -->
<!-- ZMP link LF18 -->
<joint name="jointNNFT12" type="revolute">
        <parent link="linkNN18"/>
        <child link="linkNNFT12"/>
        <origin xyz= "0 0 0" rpy="0 0 0" />
        <axis xyz="1 0 0"/>
        <limit effort="100" lower="-0.1" upper="0.1" velocity="0.1"/>
    </joint>

    <link name="linkNNFT12">
        <visual>
            <origin xyz="0 0.005 -0.025" rpy="0 0 0"/>
            <geometry> <box size="0.035 0.001 0.05"/> </geometry>
        </visual>
        <collision>
            <origin xyz="0 0.005 0.025" rpy="0 0 0"/>
            <geometry> <box size="0.035 0.001 0.05"/> </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0.005 -0.025" rpy="0 0 0"/> <mass value="0.05"/>
            <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
        </inertial>
    </link>

    <gazebo reference="linkNNFT12"> <material>Gazebo/Blue</material> </gazebo>
	<gazebo> <mu1>1.5</mu1><mu2>1.5</mu2></gazebo>

	<transmission name="transNNFT12">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="jointNNFT12">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="motorNNFT12">
    <hardwareInterface>EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

<!-- ################################################################### -->
<!-- ZMPLink LF181 -->
<joint name="jointNNFT12a1" type="fixed">
        <parent link="linkNNFT12"/>
        <child link="linkNNFT12a1"/>
        <origin xyz= "0 0 -0.05" rpy="0 0 0" />
        <axis xyz="1 0 0"/>
        <limit effort="30" lower="-2.617" upper="2.617" velocity="1.571"/>
    </joint>

    <link name="linkNNFT12a1">
        <visual>
            <origin xyz="0 0.05 0.005" rpy="0 0 0"/>
            <geometry> <box size="0.025 0.1 0.01"/> </geometry>
        </visual>
        <collision>
            <origin xyz="0 0.05 0.005" rpy="0 0 0"/>
            <geometry> <box size="0.025 0.1 0.01"/> </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0.05 0.005" rpy="0 0 0"/> <mass value="0.05"/>
            <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
        </inertial>
    </link>

    <gazebo reference="linkNNFT12a1"> <material>Gazebo/Blue</material> </gazebo>
<!-- ################################################################### -->
<!-- ZMPLink LF182 -->
<joint name="jointNNFT12a2" type="fixed">
        <parent link="linkNNFT12a1"/>
        <child link="linkNNFT12a2"/>
        <origin xyz= "0 0 0.025" rpy="0 0 0" />
        <axis xyz="1 0 0"/>
    	<limit effort="30" lower="-2.617" upper="2.617" velocity="1.571"/>
	</joint>

    <link name="linkNNFT12a2">
        <visual>
            <origin xyz="0 0.095 0" rpy="0 0 0"/>
            <geometry> <box size="0.025 0.001 0.05"/> </geometry>
        </visual>
        <collision>
            <origin xyz="0 0.095 0" rpy="0 0 0"/>
            <geometry> <box size="0.025 0.001 0.05"/> </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0.095 0" rpy="0 0 0"/> <mass value="0.05"/>
            <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
        </inertial>
    </link>

    <gazebo reference="linkNNFT12a2"> <material>Gazebo/Blue</material> </gazebo>

<!-- ################################################################### -->
<!--ZMP sensor-->

<gazebo reference="jointNNFT12">
  <provideFeedback>true</provideFeedback>
  <!-- turnGravityOff>false</turnGravityOff -->
</gazebo>

<gazebo>
  <plugin name="ft_lf2_sensor" filename="libgazebo_ros_ft_sensor.so">
    <updateRate>100.0</updateRate>
        <topicName>ftsensor_lf2/raw</topicName>
        <jointName>jointNNFT12</jointName>
        <gaussianNoise>0.0</gaussianNoise>
  </plugin>
</gazebo>

<!-- ################################################################### -->
