          args="-param bldwall3_description -sdf -x 2.1 -y 0.8 -z 0.0 -Y 3.1416 -model bldwall3" />
-->
<!--
	<arg name="bldwall3ca" default="$(find prj4)/sdf/bldwall3ca.sdf"/>
    <param name="bldwall3ca_description" textfile="$(arg bldwall3ca)"/>
    <node name="bldwall3ca_spawner_gz" pkg="gazebo_ros" type="spawn_model"
          args="-param bldwall3ca_description -sdf -x 2.1 -y 0.8 -z 0.0 -Y 3.1416 -model bldwall3ca" />
-->

	<arg name="Ftpole" default="$(find prj4)/urdf/Ftpole.urdf"/>
    <param name="Ftpole_description" textfile="$(arg Ftpole)"/>
    <node name="Ftpole_spawner_gz" pkg="gazebo_ros" type="spawn_model"
          args="-param Ftpole_description -sdf -x -0.5 -y 0.6 -z 0.1 -Y 0 -model Ftpole" />
<!--
	<arg name="Box" default="$(find prj4)/urdf/Box.urdf"/>
    <param name="Box_description" textfile="$(arg Box)"/>
    <node name="Box_spawner_gz" pkg="gazebo_ros" type="spawn_model"
          args="-param Box_description -sdf -x -0.5 -y 0.6 -z 0.1 -Y 0 -model Box" />
-->
    <arg name="FtpoleB" default="$(find prj4)/urdf/FtpoleB.urdf"/>
    <param name="FtpoleB_description" textfile="$(arg FtpoleB)"/>
    <node name="FtpoleB_spawner_gz" pkg="gazebo_ros" type="spawn_model"
          args="-param FtpoleB_description -sdf -x -0.5 -y 1.0 -z 0.3 -Y 0 -model FtpoleB" />


</launch>
