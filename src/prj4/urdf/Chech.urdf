<?xml version="1.0" ?>

<robot name="chech">

    <link name="base_link"></link>

    <joint name="base_joint" type="fixed">
        <parent link="base_link"/>                                                                      
        <child link="platex"/>
        <origin xyz= "0 0 0" rpy="0 0 0" />
    </joint>
      
    <link name="platex">
        <visual>
  	    <origin xyz="0 0 0" rpy="0 0 0" />
	    <geometry> <box size="1.8 0.14 0.02"/> </geometry>
	</visual>
	<collision>
	    <origin xyz="0 0 0" rpy="0 0 0" />
	    <geometry> <box size="1.8 0.14 0.02"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 0 0" rpy="0 0 0" />
	    <mass value="30" />
	    <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
	</inertial>
    </link>
    <gazebo reference="platex"> <material>Gazebo/Red</material> </gazebo>

    <joint name="joint0" type="fixed">
        <parent link="platex"/>
	<child  link="platex2"/>
	<origin xyz="0 0 0" rpy="0 0 0"/>
