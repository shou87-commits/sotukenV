<?xml version="1.0" ?>

<robot name="pole150">
    <link name="pole">
        <visual>
	    <origin xyz="0 0 0.75" rpy="0 0 0" />
	    <geometry> <box size="0.05 0.05 1.5"/> </geometry>
	    <material name=""> <color rgba="1.0 1.0 1.0 1.0" /> </material>
	</visual>
	<collision>
            <origin xyz="0 0 0.75" rpy="0 0 0" />
	    <geometry> <box size="0.05 0.05 1.5"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 0 0.75" rpy="0 0 0" />
	    <mass value="0.1" />
	    <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
	</inertial>
    </link>
    <gazebo reference="pole"> <material>Gazebo/Black</material> </gazebo>
</robot>
