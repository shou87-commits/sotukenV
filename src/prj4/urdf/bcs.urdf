<?xml version="1.0" ?>

<robot name="bcs">

    <link name="box1">
      <visual>
	<origin xyz="0 0 0" rpy="0 0 0.4" />
	<geometry> <box size="0.5 0.5 0.75"/> </geometry>
      </visual>
      <collision>
	<origin xyz="0 0 0" rpy="0 0 0.4" />
	<geometry> <box size="0.5 0.5 0.75"/> </geometry>
      </collision>
      <inertial>
	<origin xyz="0 0 0" rpy="0 0 0.4" />
	<mass value="1" />
	<inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
      </inertial>
    </link>
    <gazebo reference="box1"> <material>Gazebo/Red</material> </gazebo>

    <joint name="cyl1_joint" type="floating">
      <parent link="box1"/>
      <child  link="cyl1"/>
      <origin xyz="0 0.75 0" rpy="0 0 0"/>
    </joint>
    <link name="cyl1">
      <visual>
	<origin xyz="0 0.75 0" rpy="0 0 0" />
	<geometry> <cylinder length="1.5" radius="0.25"/> </geometry>
      </visual>
      <collision>
	<origin xyz="0 0.75 0" rpy="0 0 0" />
	<geometry> <cylinder length="1.5" radius="0.25"/> </geometry>
      </collision>
      <inertial>
	<origin xyz="0 0.75 0" rpy="0 0 0" />
	<mass value="1" />
	<inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
      </inertial>
    </link>
    <gazebo reference="cyl1"> <material>Gazebo/Green</material> </gazebo>
  
    <joint name="cyl1m_joint" type="fixed">
      <parent link="cyl1"/>
      <child  link="cyl1m"/>
      <origin xyz="-0.25 0 0" rpy="0 0 0"/>
    </joint>
    <link name="cyl1m">
      <visual>
	<origin xyz="-0.25 0 0" rpy="0 0 0" />
	<geometry> <box size="0.01 0.01 0.01"/> </geometry>
      </visual>
      <collision>
	<origin xyz="-0.25 0 0" rpy="0 0 0" />
	<geometry> <box size="0.01 0.01 0.01"/> </geometry>
      </collision>
      <inertial>
	<origin xyz="-0.25 0 0" rpy="0 0 0" />
	<mass value="0.001" />
	<inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
      </inertial>
    </link>
    <gazebo reference="cyl1m"> <material>Gazebo/White</material> </gazebo>
  
    <joint name="sph1_joint" type="fixed">
      <parent link="box1"/>
      <child  link="sph1"/>
      <origin xyz="0 0 0.375" rpy="0 0 0"/>
    </joint>
    <link name="sph1">
      <visual>
	<origin xyz="0 0 0.35" rpy="0 0 0" />
	<geometry> <sphere radius="0.35"/> </geometry>
      </visual>
      <collision>
	<origin xyz="0 0 0.35" rpy="0 0 0" />
	<geometry> <sphere radius="0.35"/> </geometry>
      </collision>
      <inertial>
	<origin xyz="0 0 0.35" rpy="0 0 0" />
	<mass value="1" />
	<inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
      </inertial>
    </link>
    <gazebo reference="sph1"> <material>Gazebo/Blue</material> </gazebo>
  
    <joint name="sph1m_joint" type="fixed">
      <parent link="sph1"/>
      <child  link="sph1m"/>
      <origin xyz="-0.375 0 0" rpy="0 0 0"/>
    </joint>
    <link name="sph1m">
      <visual>
	<origin xyz="-0.375 0 0 0" rpy="0 0 0" />
	<geometry> <box size="0.01 0.01 0.01"/> </geometry>
      </visual>
      <collision>
	<origin xyz="-0.375 0 0" rpy="0 0 0" />
	<geometry> <box size="0.01 0.01 0.01"/> </geometry>
      </collision>
      <inertial>
	<origin xyz="-0.375 0 0" rpy="0 0 0" />
	<mass value="0.001" />
	<inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
      </inertial>
    </link>
    <gazebo reference="sph1m"> <material>Gazebo/white</material> </gazebo>
  
</robot>
