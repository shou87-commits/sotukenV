<?xml version="1.0" ?>

<robot name="fence80">
    <link name="fence">
        <visual>
	    <origin xyz="0 0 0" rpy="0 0 0" />
	    <geometry> <box size="0.8 0.05 0.1"/> </geometry>
	</visual>
	<collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
	    <geometry> <box size="0.8 0.05 0.1"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 0 0" rpy="0 0 0" />
	    <mass value="1" />
	    <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
	</inertial>
    </link>
    <gazebo reference="fence"> <material>Gazebo/GreyTransparent</material> </gazebo>
</robot>
