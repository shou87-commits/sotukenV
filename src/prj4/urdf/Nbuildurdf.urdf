<!-- lens -->

    <joint name="camera_jointNN32" type="fixed"> 
        <parent link="camera_linkNN3"/>
	<child  link="camera_linkNN32"/>
	<origin xyz="0.02 0 0.025" rpy="0 1.5708 0"/>
    </joint>
    <link name="camera_linkNN32">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry> <cylinder length="0.015" radius="0.02"/> </geometry>
	</visual>
    </link>
    <gazebo reference="camera_linkNN32"> <material>Gazebo/BlackTransparent</material> </gazebo>

<!-- lens center -->
    
    <joint name="camera_jointNN3pinhole" type="fixed">
        <parent link="camera_linkNN3"/>
	<child  link="camera_linkNN3pinhole"/>
	<origin xyz="0.0125 0 0.025" rpy="0 0 0"/>
    </joint>
    <link name="camera_linkNN3pinhole">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry> <box size="0.001 0.0064 0.0048"/> </geometry>
	</visual>
    </link>
    <gazebo reference="camera_linkNN3pinhole"> <material>Gazebo/White</material> </gazebo>

    <gazebo reference="camera_linkNN3pinhole"> <!-- CCD image sensor -->
    <sensor type="depth" name="depthcamera1">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image> <width>640</width> <height>480</height> <format>R8G8B8</format> </image>
        <clip> <near>0.1</near> <far>100</far> </clip>
        <depth_camera> </depth_camera>
      </camera>

      <plugin name="camera_plugin" filename="libgazebo_ros_openni_kinect.so">
        <baseline>0.2</baseline>
        <alwaysOn>true</alwaysOn>
        <!-- Keep this zero, update_rate in the parent <sensor> tag will control the frame rate. -->
        <updateRate>0.0</updateRate>
        <cameraName>depthcamera</cameraName>
        <imageTopicName>color/image_raw</imageTopicName>
        <cameraInfoTopicName>color/camera_info</cameraInfoTopicName>
        <depthImageTopicName>depth/image_raw</depthImageTopicName>
        <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
        <pointCloudTopicName>camera/depth/points</pointCloudTopicName>
        <frameName>depthcamera_link</frameName>
        <pointCloudCutoff>0.1</pointCloudCutoff>
        <pointCloudCutoffMax>10.0</pointCloudCutoffMax>
        <distortionK1>0</distortionK1>
        <distortionK2>0</distortionK2>
        <distortionK3>0</distortionK3>
        <distortionT1>0</distortionT1>
        <distortionT2>0</distortionT2>
        <CxPrime>0</CxPrime>
        <Cx>0</Cx>
        <Cy>0</Cy>
        <focalLength>0</focalLength>
        <hackBaseline>0</hackBaseline>
      </plugin>

      </sensor>
      </gazebo>
<!-- LIDAR -->
    <joint name="jointNNLIDAR" type="fixed">
        <parent link="camera_linkNN3"/>
	<child  link="LIDAR_base"/>
	<origin xyz="0 0 0.0625" rpy="0 0 0"/>
    </joint>

    <link name="LIDAR_base">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry> <box size="0.05 0.05 0.025"/> </geometry>
	</visual>
	<collision>
	    <origin xyz="0 0 0" rpy="0 0 0"/>
	    <geometry> <box size="0.05 0.05 0.025"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 0 0" rpy="0 0 0"/> <mass value="0.025"/>
	    <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
	</inertial>
    </link>

    <gazebo reference="LIDAR_base"> <material>Gazebo/Yellow</material> </gazebo>

    <joint name="jointNNLIDAR2" type="fixed">
        <parent link="LIDAR_base"/>
	<child  link="LIDAR_top"/>
	<origin xyz="0 0 0.025" rpy="0 0 0"/>
    </joint>
    <link name="LIDAR_top">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry> <cylinder length="0.03" radius="0.025"/> </geometry>
	</visual>
	<collision>
	    <origin xyz="0 0 0" rpy="0 0 0"/>
	    <geometry> <cylinder length="0.03" radius="0.025"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 0 0" rpy="0 0 0"/> <mass value="0.025"/>
	    <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
	</inertial>
    </link>

    <gazebo reference="LIDAR_top"> <material>Gazebo/Black</material> </gazebo>

    <gazebo reference="LIDAR_top">
      <sensor name="laser" type="ray">
        <pose>0.0 0 0.0 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>484</samples>         <!-- scan range is 120deg *4+4, then 1 deg step -->
              <resolution>0.25</resolution>  <!-- dont touch this value-->
              <min_angle>-1.0472</min_angle> <!-- -60 degree is -3.1416/3 -->
              <max_angle> 1.0472</max_angle> <!-- 60 degree is 3.1416/3 -->
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>5.05</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="LIDAR_controller" filename="libgazebo_ros_laser.so">
          <topicName>/prj4/laser/scan</topicName> <!-- set same name as LIDAR class instance -->
          <frameName>noisy_laser</frameName>
        </plugin>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>False</visualize>
      </sensor>
    </gazebo>

<!-- NHead -->
    <joint name="jointNNNHead" type="fixed">
        <parent link="LIDAR_base"/>
	<child  link="NHead"/>
	<origin xyz="-0.025 0 0" rpy="0 0 0"/>
    </joint>
    <link name="NHead">
        <visual>
            <origin xyz="-0.075 0 -0.03" rpy="0 0 0"/>
            <geometry> <box size="0.15 0.2 0.08"/> </geometry>
	</visual>
	<collision>
	    <origin xyz="-0.075 0 -0.03" rpy="0 0 0"/>
	    <geometry> <box size="0.15 0.2 0.08"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="-0.075 0 -0.03" rpy="0 0 0"/> <mass value="0.5"/>
	    <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
	</inertial>
    </link>
    <gazebo reference="NHead"> <material>Gazebo/Grey</material> </gazebo>

    <joint name="NHeadEye1" type="fixed"> <!-- lens -->
        <parent link="NHead"/>
	<child  link="NHeadEye1"/>
	<origin xyz="0.025 0.075 -0.03" rpy="0 1.5708 0"/>
    </joint>
    <link name="NHeadEye1">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry> <cylinder length="0.05" radius="0.03"/> </geometry>
	</visual>
    </link>
    <gazebo reference="NHeadEye1"> <material>Gazebo/BlackTransparent</material> </gazebo>

    <joint name="NHeadEye2" type="fixed"> <!-- lens -->
