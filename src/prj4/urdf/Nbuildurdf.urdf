<!-- depthcamera 1 -->
<!-- camerabody -->
    <joint name="camera_jointNN3" type="fixed">
        <parent link="camera_linkNN1"/>
	<child  link="camera_linkNN3"/>
	<origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>
    <link name="camera_linkNN3">
        <visual>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <geometry> <box size="0.025 0.05 0.05"/> </geometry>
	</visual>
    </link>
