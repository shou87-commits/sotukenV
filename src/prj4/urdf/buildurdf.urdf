    <joint name="jointNNFT11" type="revolute"> <!-- revolute for ft sensor -->
        <parent link="linkNN17"/>
        <child link="linkNNFT11"/>
        <origin xyz= "0 0 0" rpy="0 0 0" />
        <axis xyz="1 0 0"/>
        <limit effort="0" lower="0" upper="0" velocity="0"/>
    </joint>

    <link name="linkNNFT11">
        <visual>
            <origin xyz="0 0.005 0.025" rpy="0 0 0"/>
            <geometry> <box size="0.035 0.001 0.05"/> </geometry>
        </visual>
        <collision>
