<?xml version="1.0"?>

<!-- Note that you cannot place Japanese comment before melodic -->

<robot name="prj4">
    <gazebo>
        <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
	    <robotNamespace>prj4</robotNamespace>
<!-- 	    <legacyModeNS>true</legacyModeNS> for kinetic, but may be unnecessary -->
        </plugin>
    </gazebo>

<!-- ################################################################### -->

<!-- activate either one -->

    <link name="base_link"> </link>
<!--
    <link name="world"> </link>
-->

<!-- if joint type is set to "fixed", robot floats on the ground -->
<!-- but later, such situation was corrected, and current adequate value is "fixed" -->

<!-- When parent is base_link, robot can move around in the world freely -->
<!-- When parent is world, robot is fixed and can not move around in the world -->

    <joint name="body_joint" type="fixed">

        <parent link="base_link"/>
<!--
        <parent link="world"/>
-->
	<child link="body"/>
	<origin xyz= "0 0 0" rpy="0 0 0" />
    </joint>

    <link name="body">
        <visual>
	    <origin xyz="0 0 0" rpy="0 0 0"/>
	    <geometry> <box size="0.3 0.2 0.05"/> </geometry>
	</visual>
	<collision>
	    <origin xyz="0 0 0" rpy="0 0 0"/>
	    <geometry> <box size="0.3 0.2 0.05"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 0 0" rpy="0 0 0"/> <mass value="1"/>
	    <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
	</inertial>
    </link>

    <gazebo reference="body"> <material>Gazebo/Grey25</material> </gazebo>

    <joint name="bodyleft_joint" type="fixed">
        <parent link="body"/>
	<child link="bodyleft"/>
	<origin xyz= "0 0 0" rpy="0 0 0" />
    </joint>

    <link name="bodyleft">
        <visual>
	    <origin xyz="0 0.1 -0.05" rpy="0 0 0"/>
	    <geometry> <box size="0.3 0.05 0.15"/> </geometry>
	</visual>
	<collision>
	    <origin xyz="0 0.1 -0.05" rpy="0 0 0"/>
	    <geometry> <box size="0.3 0.05 0.15"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 0.1 -0.05" rpy="0 0 0"/> <mass value="0.5"/>
	    <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
	</inertial>
    </link>

    <gazebo reference="bodyleft"> <material>Gazebo/Grey25</material> </gazebo>

    <joint name="bodyright_joint" type="fixed">
        <parent link="body"/>
	<child link="bodyright"/>
	<origin xyz= "0 0 0" rpy="0 0 0" />
    </joint>

    <link name="bodyright">
        <visual>
	    <origin xyz="0 -0.1 -0.05" rpy="0 0 0"/>
	    <geometry> <box size="0.3 0.05 0.15"/> </geometry>
	</visual>
	<collision>
	    <origin xyz="0 -0.1 -0.05" rpy="0 0 0"/>
	    <geometry> <box size="0.3 0.05 0.15"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 -0.1 -0.05" rpy="0 0 0"/> <mass value="0.5"/>
	    <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
	</inertial>
    </link>

    <gazebo reference="bodyright"> <material>Gazebo/Grey25</material> </gazebo>

<!-- ################################################################### -->

    <joint name="jointNN81" type="revolute">
        <parent link="bodyleft"/>
        <child link="linkNN81"/>
        <origin xyz= "0 0.075 -0.125" rpy="0 0 0" />
        <axis xyz="1 0 0"/>
        <limit effort="30" lower="-2.617" upper="2.617" velocity="1.571"/>
    </joint>
    <link name="linkNN81">
    	<visual>
	    <origin xyz="0 -0.035 0" rpy="0 0 0"/>
	    <geometry> <box size="0.3 0.075 0.01"/> </geometry>
	</visual>
	<collision>
	    <origin xyz="0 -0.035 0" rpy="0 0 0"/>
	    <geometry> <box size="0.3 0.075 0.01"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 -0.035 0" rpy="0 0 0"/> <mass value="0.05"/>
	    <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
	</inertial>
    </link>

    <joint name="jointNN82" type="revolute">
        <parent link="bodyright"/>
        <child link="linkNN82"/>
        <origin xyz= "0 -0.075 -0.125" rpy="0 0 0" />
        <axis xyz="1 0 0"/>
        <limit effort="30" lower="-2.617" upper="2.617" velocity="1.571"/>
    </joint>
    <link name="linkNN82">
    	<visual>
	    <origin xyz="0 0.035 0" rpy="0 0 0"/>
	    <geometry> <box size="0.3 0.075 0.01"/> </geometry>
	</visual>
	<collision>
	    <origin xyz="0 0.035 0" rpy="0 0 0"/>
	    <geometry> <box size="0.3 0.075 0.01"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 0.035 0" rpy="0 0 0"/> <mass value="0.05"/>
	    <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
	</inertial>
    </link>

    <gazebo reference="linkNN81"> <material>Gazebo/Grey</material> </gazebo>
    <gazebo reference="linkNN82"> <material>Gazebo/Grey</material> </gazebo>

    <transmission name="transNN81">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="jointNN81">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="motorNN81">
        <hardwareInterface>EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="transNN82">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="jointNN82">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="motorNN82">
        <hardwareInterface>EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

<!-- ################################################################### -->

    <joint name="tail_joint" type="fixed">
        <parent link="body"/>
	<child link="tail"/>
	<origin xyz= "-0.15 0 0.025" rpy="0 0 0" />
<!--	<origin xyz= "-0.15 0 0.075" rpy="0 0 0" /> -->
    </joint>

    <link name="tail">
        <visual>
	    <origin xyz="-0.1 0 0" rpy="0 0 0"/>
	    <geometry> <box size="0.2 0.05 0.05"/> </geometry>
	</visual>
	<collision>
	    <origin xyz="-0.1 0 0" rpy="0 0 0"/>
	    <geometry> <box size="0.2 0.05 0.05"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="-0.1 0 0" rpy="0 0 0"/> <mass value="0.5"/>
	    <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
	</inertial>
    </link>

    <gazebo reference="tail"> <material>Gazebo/Grey25</material> </gazebo>

<!-- ################################################################### -->
