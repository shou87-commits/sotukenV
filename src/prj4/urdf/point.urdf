<?xml version="1.0" ?>
<robot name="points">

  <link name="p0">
    <visual>
      <origin xyz="2 0 0" rpy="0 0 0" />
      <geometry> <box size="0.2 0.2 0.2"/> </geometry>
    </visual>
    <collision>
      <origin xyz="2 0 0" rpy="0 0 0" />
      <geometry> <box size="0.2 0.2 0.2"/> </geometry>
    </collision>
    <inertial>
      <origin xyz="2 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
  </link>
  <gazebo reference="p0"> <material>Gazebo/Yellow</material> </gazebo>

  <joint name="j01" type="fixed">
    <parent link="p0"/>
    <child  link="p1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="p1">
    <visual>
      <origin xyz="3 0 0" rpy="0 0 0" />
      <geometry> <box size="0.2 0.2 0.2"/> </geometry>
    </visual>
  </link>
  <gazebo reference="p1"> <material>Gazebo/Blue</material> </gazebo>

  <joint name="j02" type="fixed">
    <parent link="p0"/>
    <child  link="p2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="p2">
    <visual>
      <origin xyz="4 0 0" rpy="0 0 0" />
      <geometry> <box size="0.2 0.2 0.2"/> </geometry>
    </visual>
  </link>
  <gazebo reference="p2"> <material>Gazebo/Blue</material> </gazebo>

</robot>
