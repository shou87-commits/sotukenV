<!-- -->  
  <gazebo> <static>true</static> </gazebo>

  <link name="base_link"> </link>

  <joint name="world_joint" type="fixed">
    <parent link="base_link"/>
    <child link="redboxs"/>
    <origin xyz= "0 0 0" rpy="0 0 0" />
  </joint>

  <link name="redboxs">
    <visual>
      <origin xyz="0 0 0.005" rpy="0 0 0" />
      <geometry> <box size="0.05 0.05 0.01"/> </geometry>
      <material name=""> <color rgba="0.0 1.0 0.0 1.0" /> </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.005" rpy="0 0 0" />
      <geometry> <box size="0.05 0.05 0.01"/> </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.005" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
  </link>

<gazebo reference="redboxs"> <material>Gazebo/Red</material> </gazebo>

</robot>
