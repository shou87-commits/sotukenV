<!-- LIDAR -->
    <joint name="jointNNLIDAR" type="fixed">
        <parent link="camera_linkNN3"/>
	<child  link="LIDAR_base"/>
	<origin xyz="0 0 0.0625" rpy="0 0 0"/>
    </joint>

    <link name="LIDAR_base">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry> <box size="0.05 0.05 0.025"/> </geometry>
	</visual>
	<collision>
	    <origin xyz="0 0 0" rpy="0 0 0"/>
	    <geometry> <box size="0.05 0.05 0.025"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 0 0" rpy="0 0 0"/> <mass value="0.1"/>
	    <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
	</inertial>
    </link>

    <gazebo reference="LIDAR_base"> <material>Gazebo/Yellow</material> </gazebo>

    <joint name="jointNNLIDAR2" type="fixed">
        <parent link="LIDAR_base"/>
	<child  link="LIDAR_top"/>
	<origin xyz="0 0 0.025" rpy="0 0 0"/>
    </joint>
    <link name="LIDAR_top">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry> <cylinder length="0.03" radius="0.025"/> </geometry>
	</visual>
	<collision>
	    <origin xyz="0 0 0" rpy="0 0 0"/>
	    <geometry> <cylinder length="0.03" radius="0.025"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 0 0" rpy="0 0 0"/> <mass value="0.1"/>
	    <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
	</inertial>
    </link>

    <gazebo reference="LIDAR_top"> <material>Gazebo/Black</material> </gazebo>

    <gazebo reference="LIDAR_top">
      <sensor name="laser" type="ray">
        <pose>0.0 0 0.0 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>484</samples>         <!-- scan range is 120deg *4+4, then 1 deg step -->
              <resolution>0.25</resolution>  <!-- dont touch this value-->
              <min_angle>-1.0472</min_angle> <!-- -60 degree is -3.1416/3 -->
              <max_angle> 1.0472</max_angle> <!-- 60 degree is 3.1416/3 -->
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>5.05</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="LIDAR_controller" filename="libgazebo_ros_laser.so">
          <topicName>/prj4/laser/scan</topicName> <!-- set same name as LIDAR class instance -->
          <frameName>noisy_laser</frameName>
        </plugin>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>False</visualize>
      </sensor>
    </gazebo>

<!-- ####### End of laser LIDAR Lidar lidar ############################ -->
    
