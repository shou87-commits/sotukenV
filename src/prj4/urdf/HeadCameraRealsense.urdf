<!-- head camera 1 -->
    <joint name="camera_jointNN1" type="fixed">
        <parent link="linkNN72"/>
	<child  link="camera_linkNN1"/>
	<origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>
    <link name="camera_linkNN1">
        <visual>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <geometry> <box size="0.025 0.10 0.025"/> </geometry>
	</visual>
	<collision>
	    <origin xyz="0 0 0.025" rpy="0 0 0"/>
	    <geometry> <box size="0.025 0.10 0.025"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 0 0" rpy="0 0 0"/> <mass value="0.1"/>
	    <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
	</inertial>
    </link>
    <gazebo reference="camera_linkNN1"> <material>Gazebo/Grey</material> </gazebo>

    <joint name="camera_jointNN1L" type="fixed">
        <parent link="camera_linkNN1"/>
	<child  link="camera_linkNN1L"/>
	<origin xyz="0 0.05 0.05" rpy="0 0 0"/>
    </joint>
    <link name="camera_linkNN1L">
        <visual>
            <origin xyz="0 0.05 0.025" rpy="0 1.57 0"/>
            <geometry> <cylinder length="0.025" radius="0.0125"/> </geometry>
	</visual>
	<collision>
            <origin xyz="0 0.05 0.025" rpy="0 1.57 0"/>
            <geometry> <cylinder length="0.025" radius="0.0125"/> </geometry>
	</collision>
	<inertial>
	    <origin xyz="0 0 0" rpy="0 0 0"/> <mass value="0.01"/>
	    <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
	</inertial>
    </link>
    <gazebo reference="camera_linkNN1L"> <material>Gazebo/Grey</material> </gazebo>

<!-- lens -->

    <joint name="camera_jointNN12" type="fixed"> 
        <parent link="camera_linkNN1"/>
	<child  link="camera_linkNN12"/>
	<origin xyz="0.02 0 0.025" rpy="0 1.5708 0"/>
    </joint>
    <link name="camera_linkNN12">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry> <cylinder length="0.015" radius="0.02"/> </geometry>
	</visual>
    </link>
    <gazebo reference="camera_linkNN12"> <material>Gazebo/GreyTransparent</material> </gazebo>

<!-- lens center -->
    
    <joint name="camera_jointNN1pinhole" type="fixed">
        <parent link="camera_linkNN1"/>
	<child  link="camera_linkNN1pinhole"/>
	<origin xyz="0.0125 0 0.025" rpy="0 0 0"/>
    </joint>
    <link name="camera_linkNN1pinhole">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry> <box size="0.001 0.0064 0.0048"/> </geometry>
	</visual>
    </link>
    <gazebo reference="camera_linkNN1pinhole"> <material>Gazebo/White</material> </gazebo>

    <gazebo reference="camera_linkNN1pinhole"> <!-- CCD image sensor -->
        <sensor type="camera" name="camera1">
	    <update_rate>30.0</update_rate>
	    <camera name="head">
                <horizontal_fov>1.3962634</horizontal_fov>
		<image> <width>640</width> <height>480</height> <format>R8G8B8</format> </image>
		<clip> <near>0.05</near> <far>100</far> </clip>
		<noise> <type>gaussian</type> <mean>0.0</mean> <stddev>0.01</stddev> </noise>
	    </camera>
	    <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <alwaysOn>true</alwaysOn>
		<updateRate>0.0</updateRate>
		<cameraName>prj4/camera1</cameraName> // referenced as "/prj4/camera1/image_raw" in prg4.cpp
		<imageTopicName>image_raw</imageTopicName>
		<cameraInfoTopicName>camera_info</cameraInfoTopicName>
		<frameName>camera_link_optical</frameName>
		<hackBaseline>0.0</hackBaseline>
		<distortionK1>0.0</distortionK1>
		<distortionK2>0.0</distortionK2>
		<distortionK3>0.0</distortionK3>
		<distortionT1>0.0</distortionT1>
		<distortionT2>0.0</distortionT2>
		<CxPrime>0</CxPrime>
		<Cx>0.0</Cx>
		<Cy>0.0</Cy>
		<focalLength>0.0</focalLength>
	    </plugin>
	</sensor>
    </gazebo>

<!-- ################################################################### -->
