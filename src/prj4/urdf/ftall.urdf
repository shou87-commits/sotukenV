<!-- ZMP link LF17 -->
    <joint name="jointNNFT11" type="revolute"> <!-- revolute for ft sensor -->
        <parent link="linkNN17"/>
        <child link="linkNNFT11"/>
        <origin xyz= "0 0 0" rpy="0 0 0" />
        <axis xyz="1 0 0"/>
        <limit effort="0" lower="0" upper="0" velocity="0"/>
    </joint>

    <link name="linkNNFT11">
        <visual>
            <origin xyz="0 0.005 0.025" rpy="0 0 0"/>
            <geometry> <box size="0.035 0.001 0.05"/> </geometry>
        </visual>
        <collision>
            <origin xyz="0 0.005 0.025" rpy="0 0 0"/>
            <geometry> <box size="0.035 0.001 0.05"/> </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0.005 0.025" rpy="0 0 0"/> <mass value="0.005"/>
            <inertia ixx="1e-2" ixy="0" ixz="0" iyy="1e-2" iyz="0" izz="1e-2"/>
        </inertial>
    </link>

    <gazebo reference="linkNNFT11"> <material>Gazebo/Blue</material> </gazebo>
<!--
    <gazebo> <mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
-->
    <transmission name="transNNFT11">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="jointNNFT11">
	    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
	</joint>
        <actuator name="motorNNFT11">
    	    <hardwareInterface>EffortJointInterface</hardwareInterface>
	    <mechanicalReduction>1</mechanicalReduction>
	</actuator>
    </transmission>

