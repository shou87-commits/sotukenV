    <joint name="camera_jointNN32" type="fixed"> <!-- lens -->
        <parent link="camera_linkNN3"/>
	<child  link="camera_linkNN32"/>
	<origin xyz="0.02 0 0.025" rpy="0 1.5708 0"/>
    </joint>
    <link name="camera_linkNN32">
        <visual>
            <origin xyz="0 0.05 0" rpy="0 0 0"/>
