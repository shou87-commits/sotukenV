<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="mysky">
    <scene>
      <ambient>0.75 0.75 0.75 1</ambient>
      <background>0.5 0.5 0.5 1</background>
      <sky>
        <clouds> <speed>10</speed> </clouds>
      </sky>
    </scene>
<!-- A global light source -->
    <include> <uri>model://sun</uri> </include>
<!-- A ground plane -->
    <include> <uri>model://ground_plane</uri> </include>

<!-- Local light sources -->
    <light type="point" name="point">
      <pose>-5 5 5 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>.1 .1 .1 1</specular>
      <attenuation>
        <range>10</range>
        <linear>0.2</linear>
        <constant>0.8</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="spot" name="spot">
      <pose>5 5 25 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>.2 .2 .2 1</specular>
      <attenuation>
        <range>30</range>
        <linear>0.01</linear>
        <constant>0.2</constant>
        <quadratic>0.0</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
      <spot>
        <inner_angle>0.1</inner_angle>
        <outer_angle>0.5</outer_angle>
        <falloff>1.2</falloff>
      </spot>
      <cast_shadows>false</cast_shadows>
    </light>

<!-- next directional light is similar to sun -->
<!-- Note that direction (0,0,1) causes error -->
<!--
    <light type="directional" name="directional">
      <pose>0 5 5 0 0 0</pose>
      <diffuse>0.2 0.2 0.2 1</diffuse>
      <specular>.1 .1 .1 1</specular>
      <attenuation>
        <range>10</range>
        <linear>0.01</linear>
        <constant>0.2</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
      <direction>0.01 0.01 -0.99</direction>
      <cast_shadows>true</cast_shadows>
    </light>
-->
    
<!-- comment -->
    
    <include> <uri>model://bookshelf</uri> <pose>4 7 0 0 0 0</pose> </include>

    <include> <uri>model://jersey_barrier</uri> <pose>9 4 0 0 0 1.5708</pose> </include>

    <include> <uri>model://table</uri> <pose>7 6 0 0 0 0</pose> </include>

    <include> <uri>model://dumpster</uri> <pose>-4 8 0 0 0 0</pose> </include>

    <include> <uri>model://stop_sign</uri> <pose>0 8 0 0 0 0</pose> </include>

    <include> <uri>model://speed_limit_sign</uri> <pose>1 7 0 0 0 3.1416</pose> </include>
<!-- 不要なものはコメントアウトして消せる
    <include> <uri>model://monkey_wrench</uri> <pose>3 3 0 0 0 0</pose> </include>
-->
    <include> <uri>model://mailbox</uri> <pose>2 7 0 0 0 0</pose> </include>

    <include> <uri>model://lamp_post</uri> <pose>1 8 0 0 0 0</pose> </include>

    <include> <uri>model://grey_wall</uri> <pose>6 8 0 0 0 0</pose> </include>

    <include> <uri>model://woodbox</uri> <pose>-8.5 -7 6.5 0 0 0 0</pose> </include>
    
    <include> <uri>model://oak_tree</uri> <pose>-8.5 -7 7.5 0 0 0</pose> </include>

    <include> <uri>model://slope</uri> <pose>-12 -7 -3.5 0 0.7854 0</pose> </include>

    <include> <uri>model://ladder</uri> <pose>9 0 0 0 0 1.5708</pose> </include>

    <include> <uri>model://bldwall</uri> <pose>9 -10 0 0 0 1.5708</pose> </include>

    <include> <uri>model://jgym</uri> <pose>3 -16 0 0 0 0</pose> </include>

  </world>
</sdf>
